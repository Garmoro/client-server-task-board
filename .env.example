# Browser -> NestJS
NEXT_PUBLIC_API_URL=http://localhost:4000

# NestJS -> Prisma/PostgreSQL and Go summarizer
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/summarizer?schema=public
SUMMARIZER_URL=http://summarizer:8091
WEB_ORIGIN=http://localhost:3000

# Go summarizer
HTTP_ADDR=:8091
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=conversation-summary:
REDIS_TTL_SECONDS=3600
LLM_API_KEY=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:0.5b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=300
LLM_MAX_RETRIES=1
MAX_MESSAGES=30
MAX_CONTENT_LENGTH=20000
LOG_LEVEL=info
LOG_FORMAT=json
